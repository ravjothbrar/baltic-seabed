# Baltic Seabed Watch: everything is optional. With no keys at all the site runs on
# Digitraffic (live, northern Baltic) + committed cable/pipeline/sanctions data.
# Copy to .env (never commit .env), or set these as GitHub Actions secrets for the Pages site.

# Whole-Baltic AIS (free): aisstream.io → sign in with GitHub → API Keys
AISSTREAM_API_KEY=

# Satellite-radar detections of ships not broadcasting AIS (free, non-commercial):
# globalfishingwatch.org → Our APIs → request access
GFW_API_TOKEN=

# Push FLASH/PRIORITY alerts to Discord: channel → Edit → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=

# Local server
PORT=8787
